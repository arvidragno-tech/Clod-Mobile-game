autowrap_mode = 3

[node name="Sep" type="HSeparator" parent="Margin/VBox/PlanPhase/PlanCard/VBox"]
layout_mode = 2

[node name="PlanStages" type="VBoxContainer" parent="Margin/VBox/PlanPhase/PlanCard/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 2

[node name="Sep2" type="HSeparator" parent="Margin/VBox/PlanPhase/PlanCard/VBox"]
layout_mode = 2

[node name="PlanChecks" type="VBoxContainer" parent="Margin/VBox/PlanPhase/PlanCard/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox/PlanPhase"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="PlanBackButton" type="Button" parent="Margin/VBox/PlanPhase/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_type_variation = &"GhostButton"
text = "RE-DIAGNOSE"

[node name="BeginButton" type="Button" parent="Margin/VBox/PlanPhase/Buttons"]
unique_name_in_owner = true
