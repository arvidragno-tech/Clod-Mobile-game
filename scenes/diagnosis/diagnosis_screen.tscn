[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/screens/diagnosis_screen.gd" id="1_diag"]
[ext_resource type="Script" path="res://scripts/components/scan_view.gd" id="2_scan"]

[node name="DiagnosisScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_diag")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="BackButton" type="Button" parent="Margin/VBox/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(48, 48)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"GhostButton"
text = "<"

[node name="Titles" type="VBoxContainer" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="Step" type="Label" parent="Margin/VBox/Header/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SubHeaderLabel"
text = "STEP 2 / 4 · DIAGNOSIS"

[node name="Title" type="Label" parent="Margin/VBox/Header/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "BODY SCAN"

[node name="DiagnosePhase" type="VBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="ScanRow" type="HBoxContainer" parent="Margin/VBox/DiagnosePhase"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="ScanFrame" type="PanelContainer" parent="Margin/VBox/DiagnosePhase/ScanRow"]
custom_minimum_size = Vector2(150, 200)
layout_mode = 2
theme_type_variation = &"AccentPanel"

[node name="ScanView" type="Control" parent="Margin/VBox/DiagnosePhase/ScanRow/ScanFrame"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("2_scan")

[node name="FindingsCard" type="PanelContainer" parent="Margin/VBox/DiagnosePhase/ScanRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CardPanel"

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox/DiagnosePhase/ScanRow/FindingsCard"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Findings" type="VBoxContainer" parent="Margin/VBox/DiagnosePhase/ScanRow/FindingsCard/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Caption" type="Label" parent="Margin/VBox/DiagnosePhase/ScanRow/FindingsCard/Scroll/Findings"]
layout_mode = 2
theme_type_variation = &"SubHeaderLabel"
text = "FINDINGS"

[node name="Hint" type="Label" parent="Margin/VBox/DiagnosePhase"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Tap regions to scan"
horizontal_alignment = 1

[node name="Options" type="VBoxContainer" parent="Margin/VBox/DiagnosePhase"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="ConfirmButton" type="Button" parent="Margin/VBox/DiagnosePhase"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"AccentButton"
disabled = true
text = "CONFIRM DIAGNOSIS"

[node name="PlanPhase" type="VBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="PlanCard" type="PanelContainer" parent="Margin/VBox/PlanPhase"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"AccentPanel"

[node name="VBox" type="VBoxContainer" parent="Margin/VBox/PlanPhase/PlanCard"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PlanCode" type="Label" parent="Margin/VBox/PlanPhase/PlanCard/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MonoLabel"
theme_override_colors/font_color = Color(0.180392, 0.901961, 0.784314, 1)
