class_name CityBackdrop
extends Control
## Main-menu key art (assets/sprites/ui/title_keyart.png, generated by
## tools/art/environments.py) drawn at the global pixel density and anchored
## to the bottom, with rain, a buzzing cross sign, the clinic's red work light
## and steam from the street vent. All motion is in whole art pixels.

const KEYART := "res://assets/sprites/ui/title_keyart.png"
const DROP_COUNT := 60
const DROP_SPEED := Vector2(-20.0, 260.0)  # art px / s
## Art-pixel anchors inside the key art.
const CROSS := Rect2(86, 246, 14, 14)
const DOOR_LIGHT := Rect2(82, 342, 20, 2)
const VENT := Vector2(22, 316)
const CUSTOMER_EYE := Vector2(142, 265)

var _tex: Texture2D
var _scale: float = 2.0
var _offset := Vector2.ZERO
var _drops: Array[Vector3] = []  # x, y, length (art px)
var _puffs: Array[Vector3] = []  # x, y, age
var _time: float = 0.0
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	_tex = PixelArt.tex(KEYART)
	_rng.seed = 1337
	resized.connect(_layout)
	_layout()


func _layout() -> void:
	if _tex == null:
		return
	var img := Vector2(_tex.get_size())
	_scale = float(GameConfig.PIXEL_SCALE)
	while img.x * _scale < size.x:
		_scale += 1.0
	_offset = Vector2(floorf((size.x - img.x * _scale) / 2.0), floorf(size.y - img.y * _scale))
	_drops.clear()
	for i in DROP_COUNT:
		_drops.append(Vector3(_rng.randf_range(0, img.x + 20), _rng.randf_range(0, img.y), _rng.randi_range(2, 5)))
	queue_redraw()


func _process(delta: float) -> void:
	_time += delta
	if not Settings.reduce_motion:
		var img := Vector2(_tex.get_size()) if _tex else Vector2(180, 400)
		for i in _drops.size():
			var d := _drops[i]
			d.x += DROP_SPEED.x * delta
			d.y += DROP_SPEED.y * delta * (0.7 + d.z * 0.1)
			if d.y > img.y:
				d.y = -d.z
				d.x = _rng.randf_range(0, img.x + 20)
			_drops[i] = d
		if _rng.randf() < delta * 3.0:
			_puffs.append(Vector3(VENT.x + _rng.randf_range(-6, 6), VENT.y, 0.0))
		for i in range(_puffs.size() - 1, -1, -1):
			var p := _puffs[i]
			p.z += delta
			p.y -= delta * 9.0
			p.x += sin(_time + i) * delta * 2.0
			if p.z > 2.5:
				_puffs.remove_at(i)
			else:
				_puffs[i] = p
	queue_redraw()


func _art(p: Vector2) -> Vector2:
	return _offset + p.floor() * _scale


func _draw() -> void:
	draw_rect(Rect2(Vector2.ZERO, size), Color("07060c"))
	if _tex == null:
		return
	draw_texture_rect(_tex, Rect2(_offset, Vector2(_tex.get_size()) * _scale), false)
	# Darken the sky behind the title block in hard dithered steps, so the
	# wordmark and tagline read over the city.
	var title_end := size.y * 0.5
	var step := 4
	for i in step:
		var y0 := title_end * i / step
		draw_rect(Rect2(0, floorf(y0), size.x, ceilf(title_end / step)), Color(0.02, 0.02, 0.05, 0.62 - i * 0.12))
	# Cross sign buzz: occasionally drops out for a few frames.
	if not Settings.reduce_motion and fmod(_time, 5.3) < 0.12:
		draw_rect(Rect2(_art(CROSS.position), CROSS.size * _scale), Color(0.02, 0.02, 0.04, 0.85))
	# Door work light pulses slowly.
	var pulse := 0.25 + 0.25 * sin(_time * 2.0)
	draw_rect(Rect2(_art(DOOR_LIGHT.position), DOOR_LIGHT.size * _scale), Color(1.0, 0.3, 0.3, pulse))
	# The waiting customer's optic blinks.
	if fmod(_time, 3.7) > 0.15:
		draw_rect(Rect2(_art(CUSTOMER_EYE), Vector2.ONE * _scale), Color(1.0, 0.25, 0.3, 0.9))
	for p in _puffs:
		var a := 0.18 * (1.0 - p.z / 2.5)
		draw_rect(Rect2(_art(Vector2(p.x, p.y)), Vector2(2, 1) * _scale), Color(0.75, 0.8, 0.9, a))
	# Rain: 1-art-pixel-wide streaks.
	for d in _drops:
		draw_rect(Rect2(_art(Vector2(d.x, d.y)), Vector2(1, d.z) * _scale), Color(0.55, 0.65, 0.85, 0.22))
