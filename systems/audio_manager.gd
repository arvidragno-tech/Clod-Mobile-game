extends Node
## Soundscape. Gameplay code only calls play_sfx(id); screens pick a sound
## profile (music track + ambience layer mix) via set_profile(id), which
## UIManager does on every screen change. Volumes come from Settings and run
## through six buses (Master > Music, Ambience, SFX, Dialogue, UI): UI
## clicks and hovers go to UI, character voice blips to Dialogue, so every
## volume slider controls exactly its own sounds. Missing files are skipped
## silently so audio can never break gameplay.
## Assets are generated by tools/generate_audio.py; replace any file 1:1.

const SFX_PATHS := {
	&"click": "res://audio/sfx/click.wav",
	&"tool": "res://audio/sfx/tool_select.wav",
	&"cut": "res://audio/sfx/cut.wav",
	&"burn": "res://audio/sfx/burn.wav",
	&"clamp": "res://audio/sfx/clamp.wav",
	&"zap": "res://audio/sfx/zap.wav",
	&"stitch": "res://audio/sfx/stitch.wav",
	&"implant": "res://audio/sfx/implant_install.wav",
	&"stage": "res://audio/sfx/stage_complete.wav",
	&"mistake": "res://audio/sfx/mistake.wav",
	&"warning": "res://audio/sfx/warning.wav",
	&"success": "res://audio/sfx/surgery_success.wav",
	&"failure": "res://audio/sfx/surgery_failure.wav",
	&"customer": "res://audio/sfx/customer_arrival.wav",
	&"cash": "res://audio/sfx/cash.wav",
	&"levelup": "res://audio/sfx/level_up.wav",
	&"drill": "res://audio/sfx/drill.wav",
	&"glitch": "res://audio/sfx/glitch.wav",
	&"event": "res://audio/sfx/event.wav",
	&"beep": "res://audio/sfx/monitor_beep.wav",
	&"servo": "res://audio/sfx/servo.wav",
	&"activate": "res://audio/sfx/cyber_activate.wav",
	&"critical": "res://audio/sfx/critical.wav",
	&"confirm": "res://audio/sfx/confirm.wav",
	&"back": "res://audio/sfx/back.wav",
	&"denied": "res://audio/sfx/denied.wav",
	&"unlock": "res://audio/sfx/unlock.wav",
	&"purchase": "res://audio/sfx/purchase.wav",
	&"heartbeat": "res://audio/sfx/heartbeat.wav",
	&"spark": "res://audio/sfx/spark.wav",
	&"tutorial": "res://audio/sfx/tutorial.wav",
	&"hover": "res://audio/sfx/hover.wav",
	&"voice": "res://audio/sfx/voice.wav",
	&"comms": "res://audio/sfx/comms.wav",
}
## Interface sounds route to the UI bus.
const UI_SFX := [&"click", &"hover", &"confirm", &"back", &"denied", &"tool", &"comms"]

const MUSIC_PATHS := {
	&"clinic": "res://audio/music/clinic.ogg",
	&"surgery": "res://audio/music/surgery.ogg",
	&"market": "res://audio/music/market.ogg",
	&"dialogue": "res://audio/music/dialogue.ogg",
}

const AMBIENCE_LAYERS := {
	&"hum": "res://audio/ambient/hum.ogg",
	&"vent": "res://audio/ambient/vent.ogg",
	&"crt": "res://audio/ambient/crt.ogg",
	&"city": "res://audio/ambient/city.ogg",
	&"pump": "res://audio/ambient/pump.ogg",
}

const ONESHOTS := [
	"res://audio/ambient/oneshots/drip.wav",
	"res://audio/ambient/oneshots/siren.wav",
	"res://audio/ambient/oneshots/train.wav",
	"res://audio/ambient/oneshots/servo_far.wav",
	"res://audio/ambient/oneshots/beep_far.wav",
]

## Per profile: music track and the linear gain of each ambience layer.
const PROFILES := {
	&"menu": {"music": &"clinic", "layers": {&"hum": 0.6, &"vent": 0.5, &"crt": 0.5, &"city": 0.9, &"pump": 0.4}, "oneshots": true},
	&"clinic": {"music": &"clinic", "layers": {&"hum": 1.0, &"vent": 0.7, &"crt": 0.45, &"city": 0.55, &"pump": 0.8}, "oneshots": true},
	&"surgery": {"music": &"surgery", "layers": {&"hum": 0.8, &"vent": 0.45, &"crt": 0.6, &"city": 0.15, &"pump": 0.3}, "oneshots": false},
	&"market": {"music": &"market", "layers": {&"hum": 0.3, &"vent": 0.85, &"crt": 0.2, &"city": 0.85, &"pump": 0.2}, "oneshots": true},
	&"dialogue": {"music": &"dialogue", "layers": {&"hum": 0.7, &"vent": 0.5, &"crt": 0.3, &"city": 0.4, &"pump": 0.6}, "oneshots": false},
	&"city": {"music": &"clinic", "layers": {&"hum": 0.2, &"vent": 0.3, &"crt": 0.2, &"city": 1.0, &"pump": 0.3}, "oneshots": true},
}

const BUS_MUSIC := &"Music"
const BUS_AMBIENCE := &"Ambience"
const BUS_SFX := &"SFX"
const BUS_DIALOGUE := &"Dialogue"
const BUS_UI := &"UI"
const SFX_POOL_SIZE := 10
const SFX_VOLUME_DB := -4.0
const MUSIC_VOLUME_DB := -8.0
const CROSSFADE_SEC := 1.2
const ONESHOT_INTERVAL := Vector2(9.0, 24.0)
## Minimum gap between two plays of the same SFX (prevents stacking).
const SFX_MIN_GAP_MS := 40

var profile: StringName = &""

var _streams: Dictionary = {}
var _pool: Array[AudioStreamPlayer] = []
var _ui_pool: Array[AudioStreamPlayer] = []
var _next_ui: int = 0
var _voice: AudioStreamPlayer
var _profile_before_dialogue: StringName = &""
var _next_player: int = 0
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _music_id: StringName = &""
var _layers: Dictionary = {}  # id -> AudioStreamPlayer
## Reactive mix: source (time of day, tension...) -> {layer: multiplier}.
var _mix_mods: Dictionary = {}
## 0 calm .. 1 everything is on fire: heat, emergencies, open cases, a gang
## war, the small hours. Drives the ambience mix and how open the music is.
var tension: float = 0.0
const MUSIC_CUTOFF := {&"morning": 9000.0, &"day": 20000.0, &"evening": 12000.0, &"night": 5000.0, &"late_night": 2600.0}
var _oneshot_player: AudioStreamPlayer
var _oneshot_timer: float = 12.0
var _last_played: Dictionary = {}
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_rng.randomize()
	_ensure_buses()
	for i in SFX_POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.volume_db = SFX_VOLUME_DB
		p.bus = BUS_SFX
		add_child(p)
		_pool.append(p)
	_music_a = _make_player(BUS_MUSIC)
	_music_b = _make_player(BUS_MUSIC)
	for id: StringName in AMBIENCE_LAYERS:
		var p := _make_player(BUS_AMBIENCE)
		p.volume_db = -80.0
		_layers[id] = p
	_oneshot_player = _make_player(BUS_AMBIENCE)
	for i in 4:
		var p := _make_player(BUS_UI)
		p.volume_db = SFX_VOLUME_DB
		_ui_pool.append(p)
	_voice = _make_player(BUS_DIALOGUE)
	_voice.volume_db = SFX_VOLUME_DB
	Settings.changed.connect(apply_volumes)
	apply_volumes()
	for sig: Signal in [EventBus.heat_changed, EventBus.customer_arrived, EventBus.customer_left, EventBus.world_event_started, EventBus.period_changed]:
		sig.connect(func(_a: Variant = null, _b: Variant = null) -> void: update_tension.call_deferred())
	SecurityManager.cases_changed.connect(update_tension)


func _make_player(bus: StringName) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = bus
	add_child(p)
	return p


func _ensure_buses() -> void:
	for bus in [BUS_MUSIC, BUS_AMBIENCE, BUS_SFX, BUS_DIALOGUE, BUS_UI]:
		if AudioServer.get_bus_index(bus) == -1:
			AudioServer.add_bus()
			var idx := AudioServer.bus_count - 1
			AudioServer.set_bus_name(idx, bus)
			AudioServer.set_bus_send(idx, &"Master")
	var mi := AudioServer.get_bus_index(BUS_MUSIC)
	if mi >= 0 and AudioServer.get_bus_effect_count(mi) == 0:
		var lp := AudioEffectLowPassFilter.new()
		lp.cutoff_hz = 20000.0
		AudioServer.add_bus_effect(mi, lp)


## Applies Settings volumes to the buses (linear 0..1 -> dB, 0 = mute).
func apply_volumes() -> void:
	_set_bus_volume(&"Master", Settings.master_volume)
	_set_bus_volume(BUS_MUSIC, Settings.music_volume)
	_set_bus_volume(BUS_AMBIENCE, Settings.ambience_volume)
	_set_bus_volume(BUS_SFX, Settings.sfx_volume)
	_set_bus_volume(BUS_DIALOGUE, Settings.dialogue_volume)
	_set_bus_volume(BUS_UI, Settings.ui_volume)


func _set_bus_volume(bus: StringName, linear: float) -> void:
	var idx := AudioServer.get_bus_index(bus)
	if idx == -1:
		return
	AudioServer.set_bus_mute(idx, linear <= 0.001)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(linear, 0.001)))


func _exit_tree() -> void:
	stop_all()


## Stops every playback (used before quitting so streams release cleanly).
func stop_all() -> void:
	for p: AudioStreamPlayer in _pool + _ui_pool + [_music_a, _music_b, _oneshot_player, _voice] + _layers.values():
		if p:
			p.stop()
			p.stream = null
	_streams.clear()
	_music_id = &""
	profile = &""


func play_sfx(id: StringName, pitch_variance: float = 0.05) -> void:
	var ui := UI_SFX.has(id)
	if (Settings.ui_volume if ui else Settings.sfx_volume) <= 0.001:
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_played.get(id, -1000)) < SFX_MIN_GAP_MS:
		return
	_last_played[id] = now
	var stream := _get_stream(SFX_PATHS.get(id, ""))
	if stream == null:
		return
	var player: AudioStreamPlayer
	if ui:
		player = _ui_pool[_next_ui]
		_next_ui = (_next_ui + 1) % _ui_pool.size()
	else:
		player = _pool[_next_player]
		_next_player = (_next_player + 1) % _pool.size()
	player.stream = stream
	player.pitch_scale = 1.0 + _rng.randf_range(-pitch_variance, pitch_variance)
	player.play()


## A character's voice: a short pitched blip per few typed letters (Dialogue bus).
func play_voice(pitch: float = 1.0) -> void:
	if Settings.dialogue_volume <= 0.001 or _voice == null:
		return
	var stream := _get_stream(SFX_PATHS[&"voice"])
	if stream == null:
		return
	_voice.stream = stream
	_voice.pitch_scale = clampf(pitch * _rng.randf_range(0.92, 1.08), 0.5, 2.0)
	_voice.play()


## Conversations get their own quiet mix; the previous one comes back after.
func enter_dialogue() -> void:
	if profile != &"dialogue":
		_profile_before_dialogue = profile
		set_profile(&"dialogue")


func exit_dialogue() -> void:
	if profile == &"dialogue" and _profile_before_dialogue != &"":
		set_profile(_profile_before_dialogue)


func bus_volume_db(bus: StringName) -> float:
	var idx := AudioServer.get_bus_index(bus)
	return AudioServer.get_bus_volume_db(idx) if idx >= 0 else -80.0


## Switches music and ambience mix for a screen ("menu", "clinic",
## "surgery", "market"). Unknown ids keep the current profile.
func set_profile(id: StringName) -> void:
	if id == profile or not PROFILES.has(id):
		return
	profile = id
	var p: Dictionary = PROFILES[id]
	play_music(p["music"])
	refresh_mix()


## Ambience layers for the current profile, scaled by every reactive source.
func layer_level(layer_id: StringName) -> float:
	if profile == &"":
		return 0.0
	var v := float((PROFILES[profile]["layers"] as Dictionary).get(layer_id, 0.0))
	for src: Variant in _mix_mods:
		v *= float((_mix_mods[src] as Dictionary).get(String(layer_id), 1.0))
	return clampf(v, 0.0, 1.5)


func refresh_mix() -> void:
	for layer_id: StringName in _layers:
		_fade_layer(layer_id, layer_level(layer_id))


## Time of day, tension and danger reshape the ambience (multipliers per
## layer, e.g. {"city": 1.4}).
func set_mix_mod(source: StringName, mods: Dictionary) -> void:
	if _mix_mods.get(source, {}) == mods:
		return
	_mix_mods[source] = mods.duplicate()
	if profile != &"":
		refresh_mix()


## Compatibility with Step 1/2 callers.
func play_ambient(id: StringName) -> void:
	set_profile(&"menu" if id == &"clinic" and profile == &"" else id)


func play_music(id: StringName) -> void:
	if id == _music_id:
		return
	_music_id = id
	var stream := _get_stream(MUSIC_PATHS.get(id, ""), true)
	var old := _music_a if _music_a.playing else _music_b
	var new := _music_b if old == _music_a else _music_a
	if old.playing:
		var t := create_tween()
		t.tween_property(old, "volume_db", -60.0, CROSSFADE_SEC)
		t.tween_callback(old.stop)
	if stream:
		new.stream = stream
		new.volume_db = -60.0
		new.play()
		create_tween().tween_property(new, "volume_db", MUSIC_VOLUME_DB, CROSSFADE_SEC)


func _fade_layer(id: StringName, linear: float) -> void:
	var p: AudioStreamPlayer = _layers[id]
	if linear > 0.0 and not p.playing:
		p.stream = _get_stream(AMBIENCE_LAYERS[id], true)
		if p.stream:
			p.volume_db = -60.0
			p.play(_rng.randf() * 2.0)
	var target := linear_to_db(maxf(linear, 0.001)) - 6.0
	create_tween().tween_property(p, "volume_db", target if linear > 0.0 else -80.0, CROSSFADE_SEC)


func _process(delta: float) -> void:
	if profile == &"" or not bool(PROFILES[profile].get("oneshots", false)):
		return
	_oneshot_timer -= delta
	if _oneshot_timer <= 0.0:
		_oneshot_timer = _rng.randf_range(ONESHOT_INTERVAL.x, ONESHOT_INTERVAL.y)
		var stream := _get_stream(ONESHOTS[_rng.randi() % ONESHOTS.size()])
		if stream:
			_oneshot_player.stream = stream
			_oneshot_player.volume_db = _rng.randf_range(-16.0, -9.0)
			_oneshot_player.pitch_scale = _rng.randf_range(0.9, 1.1)
			_oneshot_player.play()


## Legacy toggles (the main-menu sound button maps onto Settings volumes).
func is_muted() -> bool:
	return Settings.sfx_volume <= 0.001 and Settings.music_volume <= 0.001 and Settings.ambience_volume <= 0.001


func _get_stream(path: String, looping: bool = false) -> AudioStream:
	if path.is_empty():
		return null
	if not _streams.has(path):
		var s: AudioStream = load(path) as AudioStream if ResourceLoader.exists(path) else null
		if looping:
			if s is AudioStreamOggVorbis:
				(s as AudioStreamOggVorbis).loop = true
			elif s is AudioStreamWAV:
				(s as AudioStreamWAV).loop_mode = AudioStreamWAV.LOOP_FORWARD
		_streams[path] = s
	return _streams[path]


## Test helper: what is playing right now.
func get_debug_state() -> Dictionary:
	var layers := {}
	for id: StringName in _layers:
		layers[id] = (_layers[id] as AudioStreamPlayer).playing
	return {"profile": profile, "music": _music_id, "layers": layers}



## Reactive audio: recomputes tension from the state of the game. Quiet
## nights stay quiet (the music closes in, muffled); danger opens it up and
## pushes the machinery forward. Nothing dramatic unless something is.
func update_tension() -> void:
	var t := 0.0
	match SecurityManager.level_id():
		&"high":
			t += 0.3
		&"critical":
			t += 0.5
	if CustomerManager.current_customer and CustomerManager.current_customer.is_emergency:
		t += 0.4
	if not SecurityManager.open_cases().is_empty():
		t += 0.15
	if WorldEventManager.is_active(&"gang_war"):
		t += 0.2
	if TimeManager.period() == &"late_night":
		t += 0.1
	tension = clampf(t, 0.0, 1.0)
	set_mix_mod(&"tension", {"pump": 1.0 + 0.8 * tension, "hum": 1.0 + 0.3 * tension, "city": 1.0 + 0.4 * tension, "crt": 1.0 + 0.3 * tension})
	var mi := AudioServer.get_bus_index(BUS_MUSIC)
	if mi >= 0 and AudioServer.get_bus_effect_count(mi) > 0:
		var lp := AudioServer.get_bus_effect(mi, 0) as AudioEffectLowPassFilter
		if lp:
			var base := float(MUSIC_CUTOFF.get(TimeManager.period(), 20000.0))
			lp.cutoff_hz = lerpf(base, 20000.0, tension)


func music_cutoff() -> float:
	var mi := AudioServer.get_bus_index(BUS_MUSIC)
	if mi < 0 or AudioServer.get_bus_effect_count(mi) == 0:
		return 20000.0
	var lp := AudioServer.get_bus_effect(mi, 0) as AudioEffectLowPassFilter
	return lp.cutoff_hz if lp else 20000.0
